{
  "name": "margin",
  "version": "0.1.0",
  "light": {
    "paper-50": "#fbf8f3",
    "paper-100": "#f3ede3",
    "paper-200": "#ebe3d6",
    "paper-300": "#e0d5c4",
    "paper-400": "#cdbfab",
    "ink-500": "#8d8273",
    "ink-600": "#736859",
    "ink-700": "#5e554a",
    "ink-900": "#2a241d",
    "night-900": "#141210",
    "night-800": "#1b1814",
    "night-700": "#24201b",
    "night-600": "#2c2721",
    "night-500": "#36302a",
    "night-400": "#4a4239",
    "moon-500": "#8f8577",
    "moon-300": "#c9beae",
    "moon-100": "#f1eadf",
    "terracotta-l": "#c4512b",
    "terracotta-d": "#d6612f",
    "ochre-l": "#b97a0a",
    "ochre-d": "#b8811a",
    "dusk-l": "#6150a8",
    "dusk-d": "#7a6bc8",
    "lake-l": "#2f6aa8",
    "lake-d": "#3f80c8",
    "pine-l": "#1d8f7a",
    "pine-d": "#1f9c85",
    "sticker-sun": "#f0c46a",
    "sticker-clay": "#e8a088",
    "sticker-sage": "#93cdbd",
    "sticker-sky": "#9cbbe0",
    "sticker-lilac": "#c4b9ea",
    "font-display": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
    "font-text": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif",
    "font-ui": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "font-mono": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "step--2": "clamp(0.72rem, 0.70rem + 0.08vw, 0.78rem)",
    "step--1": "clamp(0.84rem, 0.82rem + 0.10vw, 0.90rem)",
    "step-0": "clamp(1.00rem, 0.96rem + 0.20vw, 1.12rem)",
    "step-1": "clamp(1.18rem, 1.10rem + 0.40vw, 1.42rem)",
    "step-2": "clamp(1.40rem, 1.24rem + 0.80vw, 1.90rem)",
    "step-3": "clamp(1.70rem, 1.40rem + 1.50vw, 2.60rem)",
    "step-4": "clamp(2.10rem, 1.55rem + 2.75vw, 3.70rem)",
    "step-5": "clamp(2.60rem, 1.70rem + 4.50vw, 5.20rem)",
    "step-6": "clamp(3.20rem, 1.80rem + 7.00vw, 7.40rem)",
    "leading-tight": "1.02",
    "leading-snug": "1.2",
    "leading-body": "1.55",
    "leading-read": "1.62",
    "leading-poem": "1.75",
    "tracking-display": "-0.025em",
    "tracking-heading": "-0.015em",
    "tracking-caps": "0.12em",
    "measure": "34em",
    "measure-wide": "44em",
    "measure-poem": "26em",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.5rem",
    "space-6": "2rem",
    "space-7": "3rem",
    "space-8": "4rem",
    "space-9": "6rem",
    "space-10": "8rem",
    "gutter": "clamp(1.25rem, 0.6rem + 3.2vw, 3.5rem)",
    "page-max": "1240px",
    "radius-sm": "6px",
    "radius-md": "12px",
    "radius-lg": "20px",
    "radius-pill": "999px",
    "hairline": "1px",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in": "cubic-bezier(0.55, 0, 0.75, 0.2)",
    "ease-inout": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-spring": "linear(0, 0.013 0.6%, 0.05 1.2%, 0.2 2.9%, 0.42 5%, 0.84 9.4%, 1.0 11.6%, 1.08 13.6%, 1.11 15.4%, 1.1 17.5%, 1.06 20.5%, 1.0 25%, 0.98 29%, 0.985 34%, 1.0 42%, 1.004 50%, 1)",
    "dur-1": "120ms",
    "dur-2": "220ms",
    "dur-3": "420ms",
    "dur-4": "800ms",
    "bg": "var(--paper-100)",
    "surface": "var(--paper-50)",
    "surface-sunk": "var(--paper-200)",
    "surface-press": "var(--paper-300)",
    "text": "var(--ink-900)",
    "text-2": "var(--ink-700)",
    "text-3": "var(--ink-600)",
    "line": "rgba(42, 36, 29, 0.12)",
    "line-strong": "var(--paper-400)",
    "accent": "var(--terracotta-l)",
    "accent-text": "#ad451f",
    "on-ink": "var(--paper-50)",
    "link": "var(--text)",
    "link-mark": "var(--terracotta-l)",
    "focus": "var(--lake-l)",
    "selection": "#f6e4b8",
    "highlight": "#f6e4b8",
    "shadow-1": "0 1px 0 rgba(42,36,29,.04), 0 10px 30px -14px rgba(74,52,24,.22)",
    "shadow-2": "0 2px 0 rgba(42,36,29,.05), 0 22px 44px -16px rgba(74,52,24,.32)",
    "grain-opacity": "0.38",
    "grain-blend": "multiply",
    "data-1": "var(--lake-l)",
    "data-2": "var(--terracotta-l)",
    "data-3": "var(--pine-l)",
    "data-pos": "var(--ochre-l)",
    "data-neg": "var(--dusk-l)",
    "data-ref": "var(--ink-500)",
    "chart-grid": "var(--paper-300)",
    "chart-axis": "var(--paper-400)",
    "tint-1": "#dbe6f3",
    "tint-pos": "#f6e4b8",
    "tint-neg": "#e3ddf3"
  },
  "dark": {
    "bg": "var(--night-800)",
    "surface": "var(--night-700)",
    "surface-sunk": "var(--night-600)",
    "surface-press": "var(--night-500)",
    "text": "var(--moon-100)",
    "text-2": "var(--moon-300)",
    "text-3": "var(--moon-500)",
    "line": "rgba(241, 234, 223, 0.10)",
    "line-strong": "var(--night-400)",
    "accent": "var(--terracotta-d)",
    "accent-text": "var(--terracotta-d)",
    "on-ink": "var(--night-800)",
    "link": "var(--text)",
    "link-mark": "var(--terracotta-d)",
    "focus": "var(--lake-d)",
    "selection": "#45371a",
    "highlight": "#45371a",
    "shadow-1": "0 1px 0 rgba(0,0,0,.2), 0 12px 32px -14px rgba(0,0,0,.6)",
    "shadow-2": "0 2px 0 rgba(0,0,0,.2), 0 22px 44px -16px rgba(0,0,0,.7)",
    "grain-opacity": "0.22",
    "grain-blend": "soft-light",
    "data-1": "var(--lake-d)",
    "data-2": "var(--terracotta-d)",
    "data-3": "var(--pine-d)",
    "data-pos": "var(--ochre-d)",
    "data-neg": "var(--dusk-d)",
    "data-ref": "var(--moon-500)",
    "chart-grid": "var(--night-600)",
    "chart-axis": "var(--night-400)",
    "tint-1": "#24364c",
    "tint-pos": "#45371a",
    "tint-neg": "#332f4c"
  }
}
